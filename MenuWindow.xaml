<Window x:Class="mur.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кафе 34"
        Height="750"
        Width="1100"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5EBDD">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="/logo.png"
                   Width="75"
                   Height="75"
                   Stretch="Uniform"
                   Margin="0,0,15,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Кафе 34"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#654321"/>

                <TextBlock Text="Меню кафе"
                           FontSize="16"
                           Foreground="#8B5E3C"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock x:Name="UserTextBlock"
                           Text="Гость"
                           FontSize="16"
                           Foreground="#654321"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <Button Content="Войти"
                        Width="100"
                        Height="38"
                        Background="#8B5E3C"
                        Foreground="White"
                        BorderThickness="0"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="SearchTextBox"
                 Grid.Row="1"
                 Height="38"
                 FontSize="16"
                 Padding="10"
                 Margin="0,0,0,15"
                 TextChanged="SearchTextBox_TextChanged"/>

        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Background="#FFFDF9"
                  BorderBrush="#D8C3AA"
                  RowBackground="#FFFDF9"
                  AlternatingRowBackground="#F0E2D1"
                  FontSize="15">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding CategoryName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat={}{0:N2} ₽}"
                                    Width="*"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Stock}"
                                    Width="*"/>

                <DataGridTextColumn Header="Порция"
                                    Binding="{Binding Portion}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Text="Добро пожаловать в наше кафе!"
                       FontSize="14"
                       Foreground="#654321"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Корзина"
                    Width="130"
                    Height="40"
                    Background="#8B5E3C"
                    Foreground="White"
                    BorderThickness="0"
                    Click="CartButton_Click"/>
        </Grid>
    </Grid>
</Window>