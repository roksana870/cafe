<Window x:Class="mur.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина — Кафе 34"
        Height="600"
        Width="850"
        MinHeight="450"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5EBDD">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#654321"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="CartDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="#FFFDF9"
                  BorderBrush="#D8C3AA"
                  RowBackground="#FFFDF9"
                  AlternatingRowBackground="#F0E2D1"
                  FontSize="15">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat={}{0:N2} ₽}"
                                    Width="*"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Total, StringFormat={}{0:N2} ₽}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TotalTextBlock"
                       Text="Итого: 0 ₽"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#654321"
                       VerticalAlignment="Center"
                       Margin="0,0,0,12"/>

            <WrapPanel Grid.Row="1"
                       HorizontalAlignment="Right">

                <Button Content="Удалить товар"
                        Width="130"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#B58A68"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RemoveButton_Click"/>

                <Button Content="Оформить заказ"
                        Width="150"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#654321"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CheckoutButton_Click"/>

                <Button Content="Закрыть"
                        Width="100"
                        Height="40"
                        Background="#8B5E3C"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CloseButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>