<Window x:Class="mur.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина"
        Height="500"
        Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#F5EBDD">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ваша корзина"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#654321"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="CartDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Background="#FFFDF9"
                  Foreground="#654321"
                  RowBackground="#FFFDF9"
                  AlternatingRowBackground="#F0E2D1">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price}"
                                    Width="100"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="110"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Total}"
                                    Width="120"/>

            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TotalTextBlock"
                   Grid.Row="2"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#654321"
                   HorizontalAlignment="Right"
                   Margin="0,15"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Удалить товар"
                    Width="130"
                    Height="40"
                    Margin="5"
                    Background="#8B5E3C"
                    Foreground="White"
                    BorderThickness="0"
                    Click="RemoveButton_Click"/>

            <Button Content="Оформить заказ"
                    Width="150"
                    Height="40"
                    Margin="5"
                    Background="#6B351F"
                    Foreground="White"
                    BorderThickness="0"
                    Click="CheckoutButton_Click"/>

            <Button Content="Закрыть"
                    Width="100"
                    Height="40"
                    Margin="5"
                    Background="#D6BBA8"
                    Foreground="#654321"
                    BorderThickness="0"
                    Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>
</Window>